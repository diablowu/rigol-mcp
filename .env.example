# USB transport (preferred when set). Set RIGOL_USB to a truthy value to connect
# over USB instead of LAN. The first Rigol USB scope is auto-discovered.
RIGOL_USB=1

# Optional: pin a specific scope by serial number when several are connected.
#RIGOL_USB_SERIAL=DS1ZA000000000

# LAN transport
RIGOL_IP=192.168.1.123
# Use "socket" for TCP port 5555 (default) or "vxi11" for TCPIP::<ip>::INSTR.
#RIGOL_LAN_PROTOCOL=vxi11

# Optional model hint so the initial MCP tool schema advertises the correct channels.
#RIGOL_MODEL=DS1202Z-E

# Enable the send_raw tool (arbitrary SCPI). Off by default — only the dedicated
# tools are exposed unless this is set.
#RIGOL_ENABLE_SEND_RAW=1
